NODE_ENV=
PORT=

DATABASE_URL=
DATABASE_URL_TEST=
DATABASE_URL_MIGRATIONS=
DB_SSL=true

# Timeouts applied locally to clinical PostgreSQL transactions (milliseconds).
CLINICAL_DB_STATEMENT_TIMEOUT_MS=15000
CLINICAL_DB_LOCK_TIMEOUT_MS=3000
CLINICAL_DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=5000

JWT_SECRET=
JWT_SECRET_TEST=
JWT_EXPIRES_IN=8h

# Proteção gradual de CPF (clientes e profissionais). NÃO ativar antes da migration 066.
# Gerar DUAS chaves aleatórias diferentes com 32 bytes, em HEX; guardar apenas em cofre.
# Não usar valores de exemplo em ambiente real nem enviar chaves ao chat.
CPF_CRYPTO_MODE=legacy
CPF_ENCRYPTION_KEY=
CPF_LOOKUP_KEY=

# Apenas para executar backfill explícito de CPF em DESENVOLVIMENTO.
# Confirme host e nome do banco separadamente a partir do console do Neon;
# informe somente hostname, sem senha nem protocolo.
CPF_DEV_EXPECTED_HOST=
CPF_DEV_EXPECTED_DATABASE=

# WhatsApp Meta integration stays disabled until explicit homologation.
WHATSAPP_META_REAL_SEND_ENABLED=false
WHATSAPP_META_COEXISTENCE_ENABLED=false
WHATSAPP_META_APP_ID=
WHATSAPP_META_CONFIGURATION_ID=
WHATSAPP_META_GRAPH_API_VERSION=v27.0
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
# Generate 32 random bytes and store their Base64 encoding in the secret manager.
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=
