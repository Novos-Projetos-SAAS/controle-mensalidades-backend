NODE_ENV=
PORT=

DATABASE_URL=
DATABASE_URL_TEST=
DATABASE_URL_MIGRATIONS=
DB_SSL=true

# Timeouts applied locally to clinical PostgreSQL transactions (milliseconds).
CLINICAL_DB_STATEMENT_TIMEOUT_MS=15000
CLINICAL_DB_LOCK_TIMEOUT_MS=3000
CLINICAL_DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=5000

JWT_SECRET=
JWT_SECRET_TEST=
JWT_EXPIRES_IN=8h

# CPF cifrado: usar as chaves originais de cada ambiente (nao versionar segredos).
# legacy nao le valores cifrados: nunca utilizar em banco ja migrado.
CPF_CRYPTO_MODE=legacy
CPF_ENCRYPTION_KEY=
CPF_LOOKUP_KEY=
CPF_DEV_EXPECTED_HOST=
CPF_DEV_EXPECTED_DATABASE=
