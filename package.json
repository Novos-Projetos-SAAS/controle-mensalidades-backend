{
    "name": "controle-mensalidades-backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
        "test": "node --env-file=.env.test --import tsx --test tests/**/*.test.ts",
        "lint": "eslint src tests",
        "lint:fix": "eslint src tests --fix",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "diagnostico:clinico:privilegios:test": "node --env-file=.env.test --import ./tests/bruno/tsx_windows_shim.mjs --import tsx src/diagnostics/postgres-clinico.ts --target=test --confirm=test",
        "diagnostico:clinico:tls:test": "node --env-file=.env.test --import ./tests/bruno/tsx_windows_shim.mjs --import tsx src/diagnostics/tls-clinico.ts --target=test --confirm=test",
        "migrate:latest": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
        "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
        "migrate:status": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:status",
        "test:cpf:unit": "node --import tsx --test tests/utils/cpf.crypto.test.ts tests/utils/cpf.utils.test.ts tests/modules/clientes/clientes.validator.cpf.test.ts",
        "test:cpf:integration": "node --env-file=.env.test --import tsx --test tests/modules/clientes/cpf-criptografia.integration.test.ts",
        "test:cpf:http": "node --env-file=.env.test --import tsx --test tests/modules/clientes/cpf-criptografia.http.test.ts",
        "cpf:verify:test": "node --env-file=.env.test --import tsx src/diagnostics/backfill-cpf.ts --dry-run",
        "cpf:backfill:test": "node --env-file=.env.test --import tsx src/diagnostics/backfill-cpf.ts --apply --target=test --confirm=CPF-TEST-ONLY",
        "cpf:verify:desenv": "node --env-file=.env --import tsx src/diagnostics/backfill-cpf-desenv.ts --dry-run",
        "cpf:backfill:desenv": "node --env-file=.env --import tsx src/diagnostics/backfill-cpf-desenv.ts --apply --target=development --confirm=CPF-DESENV-ONLY",
        "test:whatsapp": "node --env-file=.env.test --import tsx --test tests/modules/whatsapp/*.test.ts",
        "cpf:audit:test": "node --env-file=.env.test --import tsx src/diagnostics/auditar-cpf.ts --read-only --target=test",
        "cpf:audit:desenv": "node --env-file=.env --import tsx src/diagnostics/auditar-cpf.ts --read-only --target=development",
        "test:cpf:audit": "node --import tsx --test tests/utils/cpf.audit.test.ts",
        "migrations:preflight": "tsx src/diagnostics/migration-ledger-preflight.ts",
        "test:migrations:preflight": "node --import tsx --test tests/database/migration_ledger_preflight.test.ts",
        "prontuario:migrate:homologacao": "tsx src/diagnostics/migrar-prontuario-homologacao.ts",
        "prontuario:migrate:desenv": "tsx src/diagnostics/migrar-prontuario-desenv.ts",
        "test:prontuario:migrate:desenv": "node --import tsx --test tests/database/prontuario_desenv_migrations.test.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "argon2": "^0.45.1",
        "chalk": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "jsonwebtoken": "^9.0.3",
        "knex": "^3.3.0",
        "log-symbols": "^7.0.1",
        "pg": "^8.23.0",
        "zod": "^4.5.4",
        "@whiskeysockets/baileys": "7.0.0-rc14",
        "pino": "^9.0.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.4.1",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "@usebruno/cli": "^4.3.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "tsx": "^4.23.13",
        "typescript": "5.9",
        "typescript-eslint": "^8.69.0",
        "@types/qrcode": "^1.5.5"
    }
}
